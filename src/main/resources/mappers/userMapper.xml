<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

 <mapper namespace="com.minse0.spring.ex.mvc.repository.UserRepository">
	<select id="selectLastUser"
	resultType="com.minse0.spring.ex.mvc.domain.User">
		SELECT
			`id`
			, `name`
			, `yyyymmdd`
			, `email`
			, `introduce`
			, `createdAt`
			, `updatedAt`
		FROM
			`new_user`
		ORDER BY
			`id` DESC
		LIMIT
			1			
	</select>
	
	<insert id="insertUser" useGeneratedKeys="true" keyProperty="id"
	 parameterType="com.minse0.spring.ex.mvc.domain.User">
		INSERT INTO
				`new_user`
		(		
			 `name`
			, `yyyymmdd`
			, `email`
			, `introduce`
		)
		VALUES
		(
			#{name}
			, #{yyyymmdd}
			, #{email}
			, #{introduce}
		)	
	</insert>
	
	<select id="slelectCountByEmail" parameterType="string">
		SELECT
			count(*)
		FROM
			`new_user`
		WHERE
			`email` = #{email}
					
	</select>
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
 </mapper>